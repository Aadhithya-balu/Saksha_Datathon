# --- App ---
APP_NAME=SAKSHA Backend
APP_ENV=development
API_V2_PREFIX=/api/v2
DEBUG=true

# --- PostgreSQL (local or Supabase via connection pooler) ---
POSTGRES_USER=saksha_user
POSTGRES_PASSWORD=saksha_user
POSTGRES_DB=saksha_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://saksha_user:saksha_user@localhost:5432/saksha_db

# --- Supabase Auth (REST API) ---
# Get these from your Supabase project dashboard > Settings > API
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<your-anon-key>

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_USERNAME is also accepted for hosted Neo4j/Aura environments.
# NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j

# --- JWT ---
JWT_SECRET_KEY=super-secret-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM (AI chat answers) ---
# Groq is the primary provider. LLM_PROVIDER=auto builds a failover chain:
# groq -> gemini -> openai -> local templates.
# Explicit options: groq | gemini | openai | local
LLM_PROVIDER=auto
# Optional explicit model override for the selected provider:
# LLM_MODEL=llama-3.3-70b-versatile
# Groq (free API keys: https://console.groq.com/keys)
# Add fallback keys as a comma-separated list — when the primary key hits its
# usage/rate limit, the next key is used automatically:
GROQ_API_KEY=
# GROQ_API_KEY=gsk_key_one,gsk_key_two,gsk_key_three
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
ALLOWED_ORIGINS=https://saksha-datathon-csbcweuf.onslate.in,http://localhost:3000,http://localhost:5173

# --- File Storage ---
# Set SUPABASE_STORAGE_BUCKET to enable persistent cloud storage for evidence
# files. When set, uploaded files are pushed to Supabase Storage and the local
# temp copy is deleted. When unset, files are kept in UPLOAD_DIR (dev only).
# SUPABASE_STORAGE_BUCKET=evidence-files
# UPLOAD_DIR=   # defaults to backend/uploads/ when empty
