# --- App ---
APP_NAME=SAKSHA Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# --- PostgreSQL ---
POSTGRES_USER=saksha_user
POSTGRES_PASSWORD=saksha_user
POSTGRES_DB=saksha_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://saksha_user:saksha_user@localhost:5432/saksha_db

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# --- JWT ---
JWT_SECRET_KEY=super-secret-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
