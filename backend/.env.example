# --- App ---
APP_NAME=SAKSHA Backend
# development | production | test. Production enables startup safety validation
# (JWT entropy, CORS, debug flags, default passwords, SQLite) that hard-fails.
APP_ENV=development
API_V2_PREFIX=/api/v2
# APP_DEBUG and DEBUG must be false in production (enforced at startup).
APP_DEBUG=false
DEBUG=false

# --- Data mode (Issue #162/#190) ---
# production | demo | test. 'production' disables silent fallback to seeded
# demo data. An invalid/missing value refuses to start.
SAKSHA_DATA_MODE=demo

# --- Supabase PostgreSQL ---
# For deployed/concurrent API instances, prefer Supabase's Transaction Pooler.
# Copy the exact URI from Supabase Dashboard > Connect > Transaction pooler.
# It is IPv4-compatible and reuses connections efficiently. Keep the password
# URL-encoded if it contains reserved characters (for example @, :, /, or #).
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Leave DATABASE_URL unset to use the SUPABASE_DB_* values below.
DATABASE_URL=
#
# The fields below are for a direct Supabase connection and build DATABASE_URL
# only when DATABASE_URL is empty. Direct connections can require IPv6 support.
# sslmode defaults to 'require' for Supabase.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
# SQLite is intentionally not configured here. It is only an automatic demo/test
# fallback when Supabase is unavailable; production mode rejects SQLite.

# --- Supabase Auth (REST API) ---
# Get these from your Supabase project dashboard > Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-key; never expose to the frontend>
SUPABASE_STORAGE_BUCKET=evidence-files

# --- Neo4j ---
# Optional at runtime: network intelligence falls back to PostgreSQL when Neo4j
# is unreachable. Default 'neo4j' password is rejected in production.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_USERNAME is also accepted for hosted Neo4j/Aura environments.
# NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- JWT ---
# MUST be at least 64 characters everywhere (production additionally requires
# >=80 bits of entropy).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI model auto-refresh (staleness retrain, issue #145) ---
# Set false to disable the background retrain scheduler.
# AUTO_RETRAIN_ENABLED=true
# AUTO_RETRAIN_MIN_INTERVAL_SECONDS=300

# --- Brute-force protection (account lockout) ---
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Global API rate limiting (per client IP, sliding window) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_UPLOAD_MAX_REQUESTS=30
RATE_LIMIT_AI_MAX_REQUESTS=40
# Key budgets on the REAL client IP from the nginx-forwarded headers
# (X-Forwarded-For / X-Real-IP). Keep true behind the packaged nginx proxy so
# users are not throttled as one shared IP; set false only if the backend is
# exposed directly without a trusted proxy (spoofable header otherwise).
RATE_LIMIT_TRUST_XFF=true
# NOTE: limits are per backend instance. For multi-instance deployments,
# front the API with a shared rate limiter (e.g. nginx limit_req) or swap the
# store in app/core/rate_limit.py for Redis.

# --- Notification broadcast deduplication ---
# Identical broadcasts (notification_type + category + subject + title) within
# this window (hours) are NOT re-created, preventing reload/tab/retry loops
# from flooding the notification center.
NOTIFICATION_BROADCAST_DEDUP_HOURS=24

# --- Request body cap (bytes) for JSON/API payloads ---
MAX_REQUEST_BODY_BYTES=2097152

# --- LLM (AI chat answers) ---
# Groq is the primary provider. LLM_PROVIDER=auto builds a failover chain:
# groq -> gemini -> openai -> local templates.
# Explicit options: groq | gemini | openai | local
LLM_PROVIDER=auto
# Optional explicit model override for the selected provider:
# LLM_MODEL=llama-3.3-70b-versatile
# Groq (free API keys: https://console.groq.com/keys)
# Add fallback keys as a comma-separated list — when the primary key hits its
# usage/rate limit, the next key is used automatically:
GROQ_API_KEY=
# GROQ_API_KEY=<comma-separated-provider-keys>
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Tune AI chat generation (optional — defaults match current behavior).
# Higher temperature = more creative; lower = more deterministic/grounded.
LLM_CHAT_TEMPERATURE=
LLM_CHAT_MAX_TOKENS=

# --- CORS ---
ALLOWED_ORIGINS=https://saksha-datathon-csbcweuf.onslate.in,http://localhost:3000,http://localhost:5173

# --- File Storage ---
# Set SUPABASE_STORAGE_BUCKET to enable persistent cloud storage for evidence
# files. When set, uploaded files are pushed to Supabase Storage and the local
# temp copy is deleted. When unset, files are kept in UPLOAD_DIR (dev only).
# SUPABASE_STORAGE_BUCKET=evidence-files
# UPLOAD_DIR=   # defaults to backend/uploads/ when empty
