# SAKSHA frontend build-time environment.
#
# All values here are baked into the bundle at `npm run build` time and are
# visible to anyone who downloads the site — never put secrets in this file.

# API base URL. Empty/omitted => same-origin relative path "/api/v2"
# (correct when served behind the repo's nginx, which proxies /api -> :8000,
# or when using the Vite dev proxy which forwards /api -> http://127.0.0.1:8000).
# Set an absolute URL only when the API is served from another origin.
# VITE_API_BASE_URL=/api/v2